# Vector Hub Environment Configuration
# Copy to .env and fill in real values

# === Application ===
APP_NAME=Vector Hub
DEBUG=false
ENVIRONMENT=production

# === Database ===
# SQLite path or PostgreSQL URL
DATABASE_URL=sqlite:///./data/vectorhub.db

# === Authentication (Keycloak OIDC) ===
# Required in production
OIDC_ISSUER=http://localhost:8080/realms/vectorhub
OIDC_CLIENT_ID=vector-hub
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
OIDC_AUDIENCE=vector-hub-api
OIDC_JWKS_URI=

# === Demo Mode ===
# Set to "true" ONLY for local development (localhost only)
# App refuses to start in production with demo mode enabled
DEMO_MODE=false

# === LLM Integration (server-side only, opt-in) ===
# Optional: provides advisory LLM explanations grounded in records
LLM_API_KEY=
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30

# === Git ===
# Base directory for worktrees
GIT_WORKTREE_BASE=/tmp/vectorhub-worktrees

# === Session ===
SECRET_KEY=changeme-in-production
COOKIE_SECURE=false

# === Server ===
HOST=127.0.0.1
PORT=8000

# === Keycloak (compose.yaml) ===
# The Keycloak admin password
KEYCLOAK_ADMIN_PASSWORD=admin